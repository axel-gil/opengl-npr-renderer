#version 410 core

layout(location = 0) in vec3 vertexPosition;   // quad
layout(location = 1) in vec4 particleData;     // xyz + size
layout(location = 2) in vec4 particleColor;

uniform mat4 model_view;
uniform mat4 projection;
uniform vec3 light_dir;

out vec4 vColor;
out vec2 particle_uv;

void main()
{
    vec3 center = particleData.xyz;
    float size = particleData.w;

    // extract camera basis from model_view
    vec3 right = vec3(model_view[0][0], model_view[1][0], model_view[2][0]);
    vec3 up    = vec3(model_view[0][1], model_view[1][1], model_view[2][1]);

    vec3 worldPos =
        center +
        right * vertexPosition.x * size +
        up    * vertexPosition.y * size;

    gl_Position = projection * model_view * vec4(worldPos, 1.0);

    vColor = particleColor;
    particle_uv = vertexPosition.xy;
}
