#version 410 core

layout(location = 0) in vec3 quad;

uniform mat4 model_view;
uniform mat4 projection;
uniform vec3 sun_center;
uniform float sun_size;

out vec2 v_uv;

void main()
{
    vec3 right = vec3(model_view[0][0], model_view[1][0], model_view[2][0]);
    vec3 up    = vec3(model_view[0][1], model_view[1][1], model_view[2][1]);

    vec3 worldPos = sun_center + right * quad.x * sun_size + up * quad.y * sun_size;
    gl_Position = projection * model_view * vec4(worldPos, 1.0);
    v_uv = quad.xy;
}
