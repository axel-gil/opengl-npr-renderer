#version 410 core

in vec2 uv;
in vec3 normal;
in vec3 vcolor;
in vec3 v_world;

uniform sampler2D tex_diffuse;

out vec4 FragColor;

void main()
{
    vec3 N = normalize(normal);
    vec3 L = normalize(vec3(0.4, 0.7, 0.3));

    vec3 base = texture(tex_diffuse, uv).rgb * vcolor;

    float ndl = max(dot(N, L), 0.0);
    float t;
    if      (ndl > 0.70) t = 1.00;
    else if (ndl > 0.45) t = 0.70;
    else if (ndl > 0.20) t = 0.40;
    else                 t = 0.15;


    vec3 ambient = vec3(0.20, 0.25, 0.40);
    vec3 lit     = vec3(1.00, 0.98, 0.90);
    vec3 light = mix(ambient, lit, t);

    float freq = 6.0;
    float wobble = sin(v_world.y * 2.0) * 0.3;
    float stripe = sin((v_world.x + v_world.z) * freq + wobble);

    float n = fract(sin(dot(floor(v_world.xz * 3.0), vec2(12.9898, 78.233))) * 43758.5453);

    float shade = 1.0 - t;
    float strokes = step(0.6, stripe) * step(0.35, n) * shade;
    light *= 1.0 - strokes * 0.45;

    FragColor = vec4(base * light, 1.0);
}

